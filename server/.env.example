# Copy this file to server/.env and fill in your own values.
# server/.env is ignored by git, so your secret never reaches GitHub.
# On Render, set the same three values under your service's Environment settings.

# LiveKit voice (https://cloud.livekit.io, project Settings > Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
