{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "server"
      ],
      "port": 2567
    },
    {
      "name": "haunted-lobby",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "server-debug",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "server"
      ],
      "env": {
        "HAUNTED_DEBUG": "1"
      },
      "port": 2567
    }
  ]
}